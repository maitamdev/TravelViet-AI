# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# Your Supabase project ID (found in project URL)
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# Supabase anonymous/public key (safe to expose in frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Your Supabase project URL
VITE_SUPABASE_URL=https://your_project_id.supabase.co

# ==========================================
# AI Configuration (Groq)
# ==========================================
# Get your API key from: https://console.groq.com/keys
# This is used in Supabase Edge Functions (server-side only)
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# DEPLOYMENT INSTRUCTIONS (Vercel/Netlify)
# ==========================================
# 1. Copy your actual values from .env file
# 2. Go to your deployment platform settings
# 3. Add these as Environment Variables
# 4. Make sure to add them for all environments (Production, Preview, Development)
# 5. For GROQ_API_KEY, add it to Supabase Edge Function secrets:
#    supabase secrets set GROQ_API_KEY=your_key_here
